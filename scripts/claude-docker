#!/usr/bin/env bash
# claude-docker — multi-account CLI wrapper
# Run multiple Claude Code instances with independent accounts.
#
# Usage:  scripts/claude-docker <command> [args...]
#
# Commands:
#   up/down/restart   Manage containers
#   claude [svc]      Start Claude Code (default: claude-a)
#   codex [svc]       Start OpenAI Codex CLI (default: codex-a)
#   exec <svc>        Open shell in a service
#   usage [type]      Token usage report
#   build             Build/rebuild Docker image
#   config/compose    Advanced compose operations
#   help              Show help
set -euo pipefail

# Platform guard: same rationale as install.sh — refuse to run on native
# Windows shells (Git Bash, MSYS, Cygwin) where docker-compose.linux.yml's
# UID/GID override would be populated with meaningless values.
case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*)
        echo "Error: scripts/claude-docker is not supported on native Windows shells." >&2
        echo "Use: powershell scripts\\claude-docker.ps1 (or scripts\\claude-docker.cmd)" >&2
        exit 1 ;;
esac

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# --- Colors -------------------------------------------------------------------

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

log_info()  { echo -e "${CYAN}[INFO]${NC} $1"; }
log_warn()  { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

# Shared: download_tui_release() — fetches prebuilt TUI binary with SHA256 check.
# shellcheck source=lib/tui-release.sh
. "$SCRIPT_DIR/lib/tui-release.sh"
# shellcheck source=lib/parse_env.sh
. "$SCRIPT_DIR/lib/parse_env.sh"
# shellcheck source=lib/index.sh
. "$SCRIPT_DIR/lib/index.sh"
# shellcheck source=lib/runtime.sh
. "$SCRIPT_DIR/lib/runtime.sh"
# shellcheck source=lib/build-compose-cmd.sh
. "$SCRIPT_DIR/lib/build-compose-cmd.sh"

# --- Compose Command Builder --------------------------------------------------

# Populates the COMPOSE_CMD array with the full `docker compose ...` invocation.
# Array-based so paths containing whitespace survive argument parsing.
#
# Overlay selection logic:
# 1. Base docker-compose.yml is always included
# 2. docker-compose.linux.yml is added on Linux hosts when the file exists
# 3. docker-compose.worktree.yml is added when .env declares PROJECT_DIR_A
#
# build_compose_cmd() itself lives in lib/build-compose-cmd.sh (sourced above).
COMPOSE_CMD=()
COMPOSE_CMD_INITIALIZED=0

# Ensure COMPOSE_CMD is populated. Idempotent — safe to call from every subcommand.
ensure_compose_cmd() {
    if [[ "$COMPOSE_CMD_INITIALIZED" -eq 0 ]]; then
        build_compose_cmd
    fi
}

# Return a human-readable, shell-quoted version of COMPOSE_CMD for logging only.
# NEVER feed this to eval — always execute COMPOSE_CMD via "${COMPOSE_CMD[@]}".
compose_cmd_display() {
    ensure_compose_cmd
    printf '%q ' "${COMPOSE_CMD[@]}"
}

# Determine the primary interactive service
get_primary_service() {
    echo "$(agent_service_prefix)-a"
}

# --- Account Helpers ----------------------------------------------------------

# Resolve NUM_ACCOUNTS: environment, then .env, then 2.
#
# Same order as agent_runtime() in lib/runtime.sh and as both compose
# generators (#317). The first source holding a non-empty value wins even if
# that value is invalid, so an exported NUM_ACCOUNTS=abc does not silently
# fall through to .env.
#
# An unusable value emits a warning and falls back to the default instead of
# aborting: this feeds service enumeration for read-only commands like `help`,
# where printing the default pair beats printing nothing. The generators do
# abort, because they write files. Reading the environment is what makes the
# guard necessary -- until #317 only .env could reach this function.
get_num_accounts() {
    local n="${NUM_ACCOUNTS:-}" raw_n
    if [[ -z "$n" && -n "${PROJECT_ROOT:-}" ]]; then
        n=$(parse_env_value "${PROJECT_ROOT}/.env" "NUM_ACCOUNTS")
    fi
    if [[ -z "$n" ]]; then
        n=2
    else
        raw_n="$n"
        if ! n=$(normalize_account_count "$raw_n"); then
            log_warn "NUM_ACCOUNTS must be an integer between 1 and 702 (got: $raw_n); using default 2." >&2
            n=2
        fi
    fi
    printf '%s' "$n"
}

# Back-compat alias: claude-docker historically exposed the underscore
# form; keep it as a thin wrapper so any external callers (hooks, custom
# wrappers) continue to work while the canonical implementation lives in
# scripts/lib/index.sh.
_index_to_letter() {
    index_to_letter "$1"
}

# Return space-separated list of service names based on NUM_ACCOUNTS
get_service_names() {
    local n
    n=$(get_num_accounts)
    local prefix
    prefix=$(agent_service_prefix)
    local names=()
    for i in $(seq 1 "$n"); do
        names+=("${prefix}-$(_index_to_letter "$i")")
    done
    echo "${names[@]}"
}

# --- Config Dir Path Builder ---------------------------------------------------

# List account state directories under ~/.claude-state/account-*.
# Outputs one path per line.
list_account_dirs() {
    local state_base
    state_base="$(agent_state_root)"
    [[ -d "$state_base" ]] || return
    for dir in "$state_base"/account-*; do
        [[ -d "$dir" ]] || continue
        echo "$dir"
    done
}

# Build a temporary merged directory for ccusage.
# ccusage expects CLAUDE_CONFIG_DIR/projects/<hash>/*.jsonl.
# Since it does not support multiple directories, we symlink each
# account's project subdirectories into a single temporary tree.
# Also includes the host's ~/.claude/projects if present.
# Prints the temp dir path; caller is responsible for cleanup.
build_merged_config_dir() {
    local tmpdir
    tmpdir=$(mktemp -d)
    mkdir -p "$tmpdir/projects"

    # Merge container account projects
    while IFS= read -r acct_dir; do
        [[ -d "$acct_dir/projects" ]] || continue
        local acct_name
        acct_name=$(basename "$acct_dir")
        for proj in "$acct_dir/projects"/*/; do
            [[ -d "$proj" ]] || continue
            local proj_name
            proj_name=$(basename "$proj")
            ln -sf "$proj" "$tmpdir/projects/${acct_name}_${proj_name}"
        done
    done < <(list_account_dirs)

    echo "$tmpdir"
}

# --- Subcommands --------------------------------------------------------------

cmd_up() {
    ensure_compose_cmd
    echo -e "${CYAN}Starting containers...${NC}"
    echo -e "${DIM}  $(compose_cmd_display)up -d${NC}"
    "${COMPOSE_CMD[@]}" up -d "$@"
    echo -e "${GREEN}Containers started.${NC}"
    echo ""
    "${COMPOSE_CMD[@]}" ps

    # Lightweight post-start GitHub auth check (non-blocking)
    echo ""
    local cid
    local primary
    primary=$(get_primary_service)
    cid=$(get_container_id "$primary")
    if [[ -n "$cid" ]]; then
        sleep 2  # wait for entrypoint gh auth setup
        verify_container_gh_auth "$primary" || true
    fi
}

cmd_down() {
    ensure_compose_cmd
    echo -e "${CYAN}Stopping containers...${NC}"
    "${COMPOSE_CMD[@]}" down "$@"
    echo -e "${GREEN}Containers stopped.${NC}"
}

cmd_restart() {
    ensure_compose_cmd
    echo -e "${CYAN}Restarting containers...${NC}"
    "${COMPOSE_CMD[@]}" restart "$@"
    echo -e "${GREEN}Containers restarted.${NC}"
}

cmd_logs() {
    ensure_compose_cmd
    "${COMPOSE_CMD[@]}" logs -f "$@"
}

cmd_ps() {
    ensure_compose_cmd
    "${COMPOSE_CMD[@]}" ps "$@"
}

cmd_exec() {
    local service="${1:?Usage: claude-docker exec <service> [command...]}"
    shift
    ensure_compose_cmd
    if [[ $# -eq 0 ]]; then
        "${COMPOSE_CMD[@]}" exec "$service" bash
    else
        "${COMPOSE_CMD[@]}" exec "$service" "$@"
    fi
}

# cmd_agent SUBCOMMAND [args...]
# Unified runtime-launch subcommand, replacing the former cmd_claude /
# cmd_codex pair. SUBCOMMAND is the runtime name the user typed (claude or
# codex). Every runtime-specific value — binary, skip-permissions flag,
# extra run args — is read from the registry, so adding a runtime needs no
# new subcommand here.
cmd_agent() {
    local subcommand="$1"
    shift

    local runtime
    runtime="$(agent_runtime)" || exit 1

    # Wrong-runtime guard, preserved verbatim from the former cmd_codex
    # (claude-docker:239-241): a codex subcommand only works when
    # AGENT_RUNTIME selects codex. Kept codex-specific so claude's prior
    # behavior under any AGENT_RUNTIME is unchanged.
    if [[ "$subcommand" == "codex" && "$runtime" != "codex" ]]; then
        log_error "codex command requires AGENT_RUNTIME=codex. Set it in .env, regenerate compose files, then run again."
        exit 1
    fi

    # Runtime values for the *subcommand* the user typed. With the guard
    # above, subcommand and runtime agree for codex; for claude they may
    # differ (claude under AGENT_RUNTIME=codex), and the historical
    # cmd_claude always launched the claude binary regardless — so resolve
    # from the subcommand to keep that behavior.
    local binary skip_flag extra_run_args label
    binary="$(runtime_field "$subcommand" binary)"
    skip_flag="$(runtime_field "$subcommand" skipPermissionsFlag)"
    extra_run_args="$(runtime_field "$subcommand" extraRunArgs)"
    label="$(runtime_field "$subcommand" displayName)"

    # Skip-permissions flags accepted: the runtime's own flag plus the
    # universal --dangerously-skip-permissions alias (a no-op duplicate for
    # claude, the historical alias codex also honored).
    local skip_perms=false
    local service=""
    for arg in "$@"; do
        case "$arg" in
            "$skip_flag"|--dangerously-skip-permissions) skip_perms=true ;;
            *) [[ -z "$service" ]] && service="$arg" ;;
        esac
    done
    # Default service is keyed off the subcommand (claude-a / codex-a),
    # matching the former cmd_claude / cmd_codex defaults.
    service="${service:-$(runtime_field "$subcommand" servicePrefix)-a}"
    ensure_compose_cmd

    # Pretty launch banner: the label is the runtime's registry displayName,
    # so every registered runtime prints a correct name (not just claude/codex).
    echo -e "${CYAN}Starting ${label} in ${BOLD}$service${NC}${CYAN}...${NC}"

    # Build argv: binary, then registry extraRunArgs (word-split; the codex
    # entry expands to  -c cli_auth_credentials_store="file" ), then the
    # skip-permissions flag when requested.
    local agent_args=("$binary")
    if [[ -n "$extra_run_args" ]]; then
        local extra_tokens=()
        read -ra extra_tokens <<< "$extra_run_args"
        agent_args+=("${extra_tokens[@]}")
    fi
    if [[ "$skip_perms" == true ]]; then
        agent_args+=("$skip_flag")
    fi
    "${COMPOSE_CMD[@]}" exec "$service" "${agent_args[@]}"
}

# Resolve a compose service name to its running Docker container ID.
get_container_id() {
    local svc="$1"
    ensure_compose_cmd
    "${COMPOSE_CMD[@]}" ps -q "$svc" 2>/dev/null
}

# --- GitHub Auth Helpers -------------------------------------------------------

# Refresh GH_TOKEN in .env from the host's gh CLI.
# Returns 0 if token was verified/refreshed, 1 if gh is unavailable or unauthenticated.
# Non-blocking: callers should treat return 1 as a warning, not an error.
refresh_gh_token() {
    local env_file="$PROJECT_ROOT/.env"

    if ! command -v gh &>/dev/null; then
        log_info "gh CLI not found on host — skipping GitHub token refresh."
        return 1
    fi

    if ! gh auth status >/dev/null 2>&1; then
        log_warn "GitHub CLI not authenticated on host."
        echo -e "  Run: ${DIM}gh auth login -h github.com${NC}"
        echo -e "  Then: ${DIM}scripts/claude-docker gh-auth${NC}"
        return 1
    fi

    local fresh_token
    fresh_token=$(gh auth token 2>/dev/null)
    if [[ -z "$fresh_token" ]]; then
        log_warn "Could not extract GitHub token from host gh CLI."
        return 1
    fi

    # Compare with current .env value
    local current_token=""
    if [[ -f "$env_file" ]]; then
        current_token=$(parse_env_value "$env_file" "GH_TOKEN")
    fi

    if [[ "$fresh_token" == "$current_token" ]]; then
        echo -e "  ${GREEN}*${NC} GH_TOKEN is current — no update needed."
        return 0
    fi

    if [[ ! -f "$env_file" ]]; then
        log_warn ".env not found — cannot save GH_TOKEN."
        return 1
    fi

    set_env_value "$env_file" "GH_TOKEN" "$fresh_token"
    chmod 600 "$env_file"

    if [[ -z "$current_token" ]]; then
        echo -e "  ${GREEN}*${NC} GH_TOKEN added to .env."
    else
        echo -e "  ${GREEN}*${NC} GH_TOKEN refreshed in .env (token changed)."
    fi
    return 0
}

# Verify GitHub auth inside a running container.
# Uses `gh api user` rather than `gh auth status`: when GH_TOKEN coexists with
# a mounted host gh config, `gh auth status` also evaluates the unusable
# mounted `default` account and exits non-zero even though the token works.
# `gh api user` checks the credential path gh actually uses for API calls.
# Returns 0 if the API call succeeds, non-zero otherwise.
verify_container_gh_auth() {
    local svc="${1:-claude-a}"
    local cid
    cid=$(get_container_id "$svc")
    if [[ -z "$cid" ]]; then
        return 1
    fi

    if docker exec "$cid" gh api user --jq .login >/dev/null 2>&1; then
        echo -e "  ${GREEN}*${NC} GitHub auth: OK ($svc)"
        return 0
    else
        echo -e "  ${YELLOW}!${NC} GitHub auth: not configured ($svc)"
        echo -e "    ${DIM}git push/pull and gh commands may fail.${NC}"
        echo -e "    Fix: ${DIM}scripts/claude-docker gh-auth${NC}"
        return 1
    fi
}

cmd_gh_auth() {
    # Extract GitHub token from host's gh CLI and inject as GH_TOKEN in .env
    if ! command -v gh &>/dev/null; then
        log_error "gh CLI not found on host."
        exit 1
    fi

    if ! gh auth status >/dev/null 2>&1; then
        log_error "GitHub CLI not authenticated on host."
        echo -e "  Run first: ${DIM}gh auth login -h github.com${NC}"
        exit 1
    fi

    local token
    token=$(gh auth token 2>/dev/null)
    if [[ -z "$token" ]]; then
        log_error "Could not extract GitHub token from gh CLI."
        exit 1
    fi

    local env_file="$PROJECT_ROOT/.env"
    if [[ ! -f "$env_file" ]]; then
        log_error ".env file not found at $env_file"
        exit 1
    fi

    # Update or append GH_TOKEN in .env
    if grep -q '^GH_TOKEN=' "$env_file" 2>/dev/null; then
        perl -i -pe "s|^GH_TOKEN=.*|GH_TOKEN=${token}|" "$env_file"
    else
        echo "GH_TOKEN=${token}" >> "$env_file"
    fi
    chmod 600 "$env_file"

    echo -e "${GREEN}GitHub token injected into .env${NC}"

    # Restart containers if running to pick up new env
    ensure_compose_cmd
    local running
    running=$("${COMPOSE_CMD[@]}" ps -q 2>/dev/null | head -1)
    if [[ -n "$running" ]]; then
        echo -e "${CYAN}Restarting containers to apply...${NC}"
        "${COMPOSE_CMD[@]}" down && "${COMPOSE_CMD[@]}" up -d

        # Verify inside container
        sleep 2
        local primary
        primary=$(get_primary_service)
        local cid
        cid=$(get_container_id "$primary")
        if [[ -n "$cid" ]]; then
            echo ""
            echo -e "${BOLD}Verifying GitHub auth in ${primary}:${NC}"
            docker exec "$cid" gh auth status 2>&1 || true
        fi
    else
        log_info "Containers not running. Token will be available on next start."
    fi
}

cmd_build() {
    ensure_compose_cmd
    echo -e "${CYAN}Building Docker image...${NC}"
    "${COMPOSE_CMD[@]}" build "$@"
    echo -e "${GREEN}Build complete.${NC}"
}

cmd_update() {
    ensure_compose_cmd

    local binary
    binary=$(agent_binary)

    echo -e "${BOLD}Updating ${binary} CLI to latest version${NC}"
    echo ""

    # Pre-check and refresh GitHub auth token from host
    echo -e "${CYAN}[1/5] Checking GitHub auth on host...${NC}"
    local gh_ok=0
    refresh_gh_token || gh_ok=$?
    echo ""

    if [[ "$gh_ok" -ne 0 ]]; then
        echo -e "${CYAN}[2/5] Skipping token refresh (gh unavailable or unauthenticated)${NC}"
    else
        echo -e "${CYAN}[2/5] GitHub token verified${NC}"
    fi
    echo ""

    # Rebuild image without cache to force fresh native install
    echo -e "${CYAN}[3/5] Rebuilding image (--no-cache)...${NC}"
    "${COMPOSE_CMD[@]}" build --no-cache

    # Recreate containers with the new image
    echo -e "${CYAN}[4/5] Recreating containers...${NC}"
    "${COMPOSE_CMD[@]}" up -d --force-recreate

    # Verify version and GitHub auth
    echo -e "${CYAN}[5/5] Verifying...${NC}"
    local cid
    local primary
    primary=$(get_primary_service)
    cid=$(get_container_id "$primary")
    if [[ -n "$cid" ]]; then
        local version
        version=$(docker exec "$cid" "$binary" --version 2>/dev/null || echo "unknown")
        echo -e "  ${GREEN}*${NC} ${binary} version: ${BOLD}$version${NC}"

        # Wait briefly for entrypoint to complete gh auth setup
        sleep 2
        verify_container_gh_auth "$primary" || true

        echo ""
        echo -e "${GREEN}Update complete.${NC}"
    else
        echo ""
        echo -e "${GREEN}Image rebuilt.${NC} Start containers with: ${DIM}scripts/claude-docker up${NC}"
    fi
}

cmd_scale() {
    local new_count="${1:?Usage: claude-docker scale <N> (1-702)}"
    local raw_count="$new_count"

    # Validate
    if ! new_count=$(normalize_account_count "$raw_count"); then
        log_error "Account count must be between 1 and 702 (got: $raw_count)"
        exit 1
    fi

    local current_count
    current_count=$(get_num_accounts)
    echo -e "${BOLD}Scaling: $current_count → $new_count account(s)${NC}"

    # Update NUM_ACCOUNTS in .env
    local env_file="$PROJECT_ROOT/.env"
    if [[ ! -f "$env_file" ]]; then
        log_error ".env not found. Run install.sh first."
        exit 1
    fi

    if grep -q '^NUM_ACCOUNTS=' "$env_file" 2>/dev/null; then
        perl -i -pe "s/^NUM_ACCOUNTS=.*/NUM_ACCOUNTS=$new_count/" "$env_file"
    else
        echo "NUM_ACCOUNTS=$new_count" >> "$env_file"
    fi

    # Create state directories for new accounts
    if [[ "$new_count" -gt "$current_count" ]]; then
        echo -e "${CYAN}Creating new state directories...${NC}"
        for i in $(seq $((current_count + 1)) "$new_count"); do
            local letter
            letter=$(_index_to_letter "$i")
            local state_dir
            state_dir="$(agent_state_root)/account-${letter}"
            if [[ ! -d "$state_dir" ]]; then
                mkdir -p "$state_dir"
                chmod 700 "$state_dir"
                echo -e "  ${GREEN}+${NC} account-${letter}"
            fi
        done
    fi

    # Warn about memory when scaling up
    local total_mem=$((new_count * 4))
    if [[ "$new_count" -ge 4 ]]; then
        log_warn "Total memory limit: ${total_mem}G (${new_count} x 4G). Ensure sufficient host RAM."
    fi

    # Regenerate compose files
    echo -e "${CYAN}Regenerating compose files...${NC}"
    "$SCRIPT_DIR/generate-compose.sh"

    # Restart containers if running
    ensure_compose_cmd
    local running
    running=$("${COMPOSE_CMD[@]}" ps -q 2>/dev/null | head -1)
    if [[ -n "$running" ]]; then
        echo -e "${CYAN}Restarting containers...${NC}"
        "${COMPOSE_CMD[@]}" down
        # Reinitialize COMPOSE_CMD after compose file regeneration
        COMPOSE_CMD_INITIALIZED=0
        ensure_compose_cmd
        "${COMPOSE_CMD[@]}" up -d
    fi

    echo -e "${GREEN}Scaled to $new_count account(s).${NC}"

    # Show summary
    echo ""
    echo -e "${BOLD}Active services:${NC}"
    read -ra svc_names <<< "$(get_service_names)"
    for svc in "${svc_names[@]}"; do
        echo -e "  ${GREEN}*${NC} $svc"
    done
}

cmd_config() {
    ensure_compose_cmd
    echo -e "${DIM}Compose command: $(compose_cmd_display)${NC}"
    echo ""
    "${COMPOSE_CMD[@]}" config "$@"
}

cmd_compose() {
    ensure_compose_cmd
    "${COMPOSE_CMD[@]}" "$@"
}

cmd_usage() {
    # Usage aggregation availability is a per-runtime registry capability
    # (supportsUsage), not a hardcoded claude-only check.
    local runtime
    runtime="$(agent_runtime)" || exit 1
    if [[ "$(runtime_field "$runtime" supportsUsage)" != "true" ]]; then
        log_error "usage is currently Claude-only; Codex usage aggregation is not supported."
        exit 1
    fi

    # Check for npx availability (runs on host, not in container)
    if ! command -v npx &>/dev/null; then
        log_error "npx not found. Node.js is required to run ccusage."
        echo -e "  Install Node.js 20+: ${CYAN}https://nodejs.org/${NC}"
        echo -e "  macOS: ${DIM}brew install node@20${NC}"
        echo -e "  Linux: ${DIM}curl -fsSL https://deb.nodesource.com/setup_20.x | sudo -E bash - && sudo apt-get install -y nodejs${NC}"
        exit 1
    fi

    # Parse report type: first positional arg if it matches a known ccusage type
    local report_type="daily"
    local pass_args=()

    if [[ $# -gt 0 ]]; then
        case "$1" in
            daily|monthly|session|blocks|statusline)
                report_type="$1"
                shift
                ;;
        esac
    fi
    pass_args=("$@")

    # Build merged config directory with symlinks from all sources
    local merged_dir
    merged_dir=$(build_merged_config_dir)
    # shellcheck disable=SC2064 # reason: expand $merged_dir now; the local goes out of scope before EXIT fires
    trap "rm -rf '$merged_dir'" EXIT

    # Check if any project data was found
    local project_count
    project_count=$(find "$merged_dir/projects" -mindepth 1 -maxdepth 1 -type l 2>/dev/null | wc -l | tr -d ' ')

    if [[ "$project_count" -eq 0 ]]; then
        rm -rf "$merged_dir"
        log_error "No session data found."
        echo -e "  Run Claude Code in a container first to generate usage data:"
        echo -e "  ${DIM}scripts/claude-docker claude${NC}"
        exit 1
    fi

    # Display aggregation header
    echo -e "${BOLD}Token Usage Report${NC}"
    echo -e "${DIM}Report type: $report_type${NC}"
    echo -e "${DIM}Data sources (${project_count} projects):${NC}"

    while IFS= read -r acct_dir; do
        local acct_name
        acct_name=$(basename "$acct_dir")
        if [[ -d "$acct_dir/projects" ]]; then
            local count
            count=$(find "$acct_dir/projects" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')
            [[ "$count" -gt 0 ]] && echo -e "  ${GREEN}*${NC} $acct_name ${DIM}(${count} projects)${NC}"
        fi
    done < <(list_account_dirs)

    echo ""

    # Run ccusage with merged directory
    CLAUDE_CONFIG_DIR="$merged_dir" npx ccusage@latest "$report_type" ${pass_args[@]+"${pass_args[@]}"}
}

cmd_tui() {
    local tui_bin="$PROJECT_ROOT/tui/claude-docker-tui"
    if [[ ! -x "$tui_bin" ]]; then
        log_warn "TUI binary not found at $tui_bin."
        if download_tui_release "$tui_bin"; then
            exec "$tui_bin" "$@"
        fi
        log_error "Could not install TUI binary automatically."
        echo -e "  Run ${GREEN}scripts/claude-docker build-tui${NC} to build from source."
        echo -e "  Requires Go 1.21+ toolchain. Install with ${DIM}brew install go${NC} or ${DIM}apt install golang-go${NC}."
        exit 1
    fi
    exec "$tui_bin" "$@"
}

cmd_build_tui() {
    local tui_dir="$PROJECT_ROOT/tui"
    if [[ ! -d "$tui_dir" ]] || [[ ! -f "$tui_dir/go.mod" ]]; then
        log_error "TUI source not found at $tui_dir"
        exit 1
    fi
    local tui_bin="$tui_dir/claude-docker-tui"
    if ! command -v go >/dev/null 2>&1; then
        log_warn "Go toolchain not found. Attempting to download prebuilt release binary..."
        if download_tui_release "$tui_bin"; then
            return 0
        fi
        log_error "Release download failed and Go toolchain is unavailable."
        echo -e "  Install Go 1.21+ to build from source:"
        echo -e "  macOS:  ${DIM}brew install go${NC}"
        echo -e "  Linux:  ${DIM}sudo apt install golang-go${NC}"
        exit 1
    fi

    echo -e "${CYAN}Building TUI dashboard...${NC}"
    local version="dev"
    if git -C "$PROJECT_ROOT" rev-parse --short HEAD >/dev/null 2>&1; then
        version=$(git -C "$PROJECT_ROOT" rev-parse --short HEAD 2>/dev/null)
    fi

    (
        cd "$tui_dir"
        go mod download 2>&1 | tail -3
        go build -ldflags "-X main.version=$version" -o claude-docker-tui . 2>&1
    )

    if [[ -x "$tui_dir/claude-docker-tui" ]]; then
        local size
        size=$(du -h "$tui_dir/claude-docker-tui" | cut -f1)
        echo -e "${GREEN}TUI built:${NC} $tui_dir/claude-docker-tui ($size)"
        echo -e "  Launch with ${GREEN}scripts/claude-docker tui${NC}"
    else
        log_error "Build failed — binary not produced."
        exit 1
    fi
}

cmd_help() {
    ensure_compose_cmd
    local cmd_display
    cmd_display=$(compose_cmd_display)

    cat <<HELP

${BOLD}claude-docker${NC} — multi-account CLI wrapper

${BOLD}USAGE${NC}
  scripts/claude-docker <command> [args...]

${BOLD}LIFECYCLE${NC}
  ${GREEN}up${NC}                    Start all containers
  ${GREEN}down${NC}                  Stop all containers
  ${GREEN}restart${NC}               Restart all containers
  ${GREEN}build${NC}                 Build/rebuild Docker image
  ${GREEN}update${NC}                Rebuild with latest agent CLI and recreate
  ${GREEN}ps${NC}                    Show container status
  ${GREEN}logs${NC}                  Follow container logs

${BOLD}INTERACTIVE${NC}
  ${GREEN}claude${NC} [service]      Start Claude Code (default: claude-a)
  ${GREEN}codex${NC} [service]       Start OpenAI Codex CLI (default: codex-a)
  ${GREEN}tui${NC}                   Launch multi-account dashboard TUI
  ${GREEN}gh-auth${NC}               Inject GitHub token from host gh CLI into containers
  ${GREEN}exec${NC} <service>        Open shell in a service

${BOLD}USAGE TRACKING${NC}
  ${GREEN}usage${NC} [type] [flags]  Token usage report (default: daily)
                        Types: daily, monthly, session, blocks, statusline
                        Flags: --since, --until, --json, --breakdown, --compact
  ${GREEN}build-tui${NC}             Rebuild TUI dashboard binary (requires Go 1.21+)

${BOLD}SCALING${NC}
  ${GREEN}scale${NC} <N>             Set number of accounts (1-702) and regenerate

${BOLD}ADVANCED${NC}
  ${GREEN}config${NC}                Show resolved compose configuration
  ${GREEN}compose${NC} ...           Pass raw args to docker compose

${BOLD}SERVICES ($(get_num_accounts) configured)${NC}
HELP

    # Dynamic service list
    read -ra svc_names <<< "$(get_service_names)"
    local prefix
    prefix=$(agent_service_prefix)
    for idx in "${!svc_names[@]}"; do
        local svc="${svc_names[$idx]}"
        local suffix="${svc#${prefix}-}"
        local label
        label="Account $(printf '%s' "$suffix" | tr '[:lower:]' '[:upper:]')"
        if [[ "$idx" -eq 0 ]]; then
            label="$label (default)"
        fi
        printf "  %-22s%s\n" "$svc" "$label"
    done

    cat <<HELP

${BOLD}DETECTED COMPOSE COMMAND${NC}
  ${DIM}${cmd_display}${NC}

HELP
}

# --- Main ---------------------------------------------------------------------

# is_runtime_subcommand NAME
# True when NAME is a registered runtime (claude, codex, ...). The runtime
# subcommands are dispatched to cmd_agent rather than enumerated in the
# case statement, so a new registry entry needs no change here.
is_runtime_subcommand() {
    local name="$1" known
    while IFS= read -r known; do
        [[ "$known" == "$name" ]] && return 0
    done < <(runtime_list)
    return 1
}

main() {
    local command="${1:-help}"
    shift 2>/dev/null || true

    # Runtime subcommands (claude, codex, ...) route to the unified cmd_agent.
    if is_runtime_subcommand "$command"; then
        cmd_agent "$command" "$@"
        return
    fi

    case "$command" in
        up)        cmd_up "$@" ;;
        down)      cmd_down "$@" ;;
        restart)   cmd_restart "$@" ;;
        logs)      cmd_logs "$@" ;;
        ps)        cmd_ps "$@" ;;
        exec)      cmd_exec "$@" ;;
        gh-auth)   cmd_gh_auth "$@" ;;
        usage)     cmd_usage "$@" ;;
        build)     cmd_build "$@" ;;
        build-tui) cmd_build_tui "$@" ;;
        tui|dashboard) cmd_tui "$@" ;;
        update)    cmd_update "$@" ;;
        scale)     cmd_scale "$@" ;;
        config)    cmd_config "$@" ;;
        compose)   cmd_compose "$@" ;;
        help|--help|-h)  cmd_help ;;
        *)
            echo -e "${RED}Unknown command: $command${NC}" >&2
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
